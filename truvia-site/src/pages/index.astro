---
const title = "About — Truvia Travel";
const pathname = Astro.url.pathname;

const links = [
  { href: "/", label: "Home" },
];

const isActive = (href: string) => {
  if (href === "/") return pathname === "/";
  return pathname.startsWith(href);
};

import "../styles/global.css";

import { Image } from "astro:assets";
import corfu from "../assets/corfu_edited.jpg";
import amalfi from "../assets/amalfi.jpg";
import istanbul from "../assets/istanbul.jpg";
import krabi from "../assets/krabi.jpg";
import lapland from "../assets/lapland.jpg";
import london from "../assets/london2.jpg";
import madeira from "../assets/madeira.jpg";
import marrakech from "../assets/marrakech.jpg";
import paris from "../assets/paris.jpeg";
import prague from "../assets/prague.jpg";
import pfp from "../assets/Profile-Pic.jpg";
import riodejaneiro from "../assets/riodejaneiro.jpg";
import tokyo from "../assets/tokyo.jpg";
import zermatt from "../assets/zermatt.jpg";

---


<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{title}</title>
    </head>

    <body class="bg-white text-slate-900 font-pristine">
        <!-- NAVBAR -->
        <header class="sticky top-0 z-50 border-b border-black/20 bg-[#2C1239]">
        <div class="flex items-center justify-between px-4 sm:px-6 py-0">
            <!-- Logo -->
            <a href="/" class="flex items-center py-0 my-0 leading-none">
			<img
				src="/logo_truvia.jpg"
				alt="Truvia Travel logo"
				class="block h-14 w-auto object-contain"
			/>
			</a>

            <!-- Desktop Nav -->
            <nav class="hidden items-center gap-3 text-sm font-medium sm:flex">
            {links.map((l) => (
                <a
                href={l.href}
                class:list={[
                    "rounded-full px-3 py-2 transition",
                    "text-white/80 hover:text-white hover:bg-white/10",
                    "focus:outline-none focus-visible:ring-2 focus-visible:ring-white/40",
                    isActive(l.href) ? "bg-white/15 text-white" : "",
                ]}
                aria-current={isActive(l.href) ? "page" : undefined}
                >
                {l.label}
                </a>
            ))}

            <!-- Language toggle -->
            <button
                id="lang-toggle"
                type="button"
                aria-label="Switch language"
                class="inline-flex items-center gap-1 rounded-full border border-white/30 px-3 py-1.5 text-xs font-semibold hover:bg-white/10 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-white/40"
            >
                <span id="lang-label-sq" class="text-white transition">AL</span>
                <span class="text-white/30">|</span>
                <span id="lang-label-en" class="text-white/40 transition">EN</span>
            </button>

            <!-- CTA -->
            <a
                href="/contact"
                data-al="Na kontaktoni"
                data-en="Contact us"
                class="inline-flex items-center rounded-full bg-white px-4 py-2 text-sm font-semibold text-[#0B3D2E] shadow-sm transition hover:bg-white/90 focus:outline-none focus-visible:ring-2 focus-visible:ring-white/40"
            >
                Na kontaktoni
            </a>
            </nav>

            <!-- Mobile right side -->
            <div class="flex items-center gap-2 sm:hidden">
            <button
                id="lang-toggle-mobile"
                type="button"
                aria-label="Switch language"
                class="inline-flex items-center gap-1 rounded-full border border-white/30 px-2.5 py-1 text-xs font-semibold hover:bg-white/10 transition"
            >
                <span id="lang-label-sq-mob" class="text-white transition">AL</span>
                <span class="text-white/30">|</span>
                <span id="lang-label-en-mob" class="text-white/40 transition">EN</span>
            </button>
            <button
                id="nav-toggle"
                type="button"
                class="inline-flex items-center justify-center rounded-xl p-2 text-white/90 transition hover:bg-white/10 focus:outline-none focus-visible:ring-2 focus-visible:ring-white/40"
                aria-label="Open menu"
                aria-expanded="false"
                aria-controls="mobile-nav"
            >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            </button>
            </div>
        </div>

        <!-- Mobile Nav -->
        <div id="mobile-nav" class="hidden border-t border-white/10 bg-[#0B3D2E] sm:hidden">
            <nav class="flex flex-col gap-1 px-4 sm:px-6 py-3 text-sm font-medium">
            {links.map((l) => (
                <a
                href={l.href}
                class:list={[
                    "rounded-xl px-3 py-2 transition",
                    "text-white/85 hover:bg-white/10 hover:text-white",
                    isActive(l.href) ? "bg-white/15 text-white" : "",
                ]}
                aria-current={isActive(l.href) ? "page" : undefined}
                >
                {l.label}
                </a>
            ))}

            <a
                href="/contact"
                data-al="Na kontaktoni"
                data-en="Contact us"
                class="mt-2 inline-flex items-center justify-center rounded-xl bg-white px-4 py-2 font-semibold text-[#0B3D2E] hover:bg-white/90"
            >
                Na kontaktoni
            </a>
            </nav>
        </div>

        <script is:inline>
            const btn = document.getElementById("nav-toggle");
            const menu = document.getElementById("mobile-nav");
            if (btn && menu) {
            btn.addEventListener("click", () => {
                const expanded = btn.getAttribute("aria-expanded") === "true";
                btn.setAttribute("aria-expanded", String(!expanded));
                menu.classList.toggle("hidden");
            });
            }
        </script>
        </header>

		<section class="relative w-full overflow-hidden h-[400px] sm:h-[520px] md:h-[620px] bg-black">
		<!-- background image -->
		<Image
			src={corfu}
			alt="Corfu"
			class="absolute inset-0 h-full w-full object-cover"
			loading="eager"
			decoding="async"
			fetchpriority="high"
		/>
        <!-- dark overlay -->
        <div class="absolute inset-0 bg-black/40"></div>

        <!-- content -->
        <div class="relative mx-auto px-6 py-24 sm:py-24">
            <p
                data-al="Këtu fillon udhëtimi juaj"
                data-en="This is where your journey begins"
                class="text-sm font-semibold tracking-[0.25em] uppercase text-white/80">
            Këtu fillon udhëtimi juaj
            </p>

            <h1
                data-al="Më pak stres. Më shumë udhëtime."
                data-en="Less stress. More travels."
                class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-5xl">
            Më pak stres. Më shumë udhëtime.
            </h1>

            <p
                data-al="Eksploro botën, planifiko udhëtime më lehtë, dhe krijo kujtime të veçanta - të gjitha në një vend."
                data-en="Explore the world, plan trips more easily, and create special memories — all in one place."
                class="mt-4 text-white/85">
            Eksploro botën, planifiko udhëtime më lehtë, dhe krijo kujtime të veçanta - të gjitha në një vend.
            </p>
        </div>
        </section>

        <!-- Kuizi -->
        <section class="mx-auto max-w-3xl px-6 pt-16 pb-10">
        <h2
            data-al="Planifiko udhëtimin tënd"
            data-en="Plan your trip"
            class="text-sm uppercase text-center tracking-[0.2em] text-slate-500 mb-2">
        Planifiko udhëtimin tënd
        </h2>
        <h3
            data-al="Ku dëshironi të shkoni? ✈️"
            data-en="Where would you like to go? ✈️"
            class="text-3xl font-semibold tracking-tight text-center text-slate-900 mb-2">
        Ku dëshironi të shkoni? ✈️
        </h3>
        <p
            data-al="Na tregoni çfarë kërkoni — ne gjejmë ofertën perfekte për ju."
            data-en="Tell us what you're looking for — we'll find the perfect offer for you."
            class="text-center text-slate-500 text-sm mb-10">
        Na tregoni çfarë kërkoni — ne gjejmë ofertën perfekte për ju.
        </p>
        <div id="quiz" class="rounded-2xl bg-white shadow-sm ring-1 ring-slate-200 p-8">
         <!--Progress bar -->
         <div class="w-full bg-slate-100 rounded-full h-1.5 mb-8">
        <div id="quiz-progress" class="bg-[#2C1239] h-1.5 rounded-full transition-all duration-500" style="width: 14%"></div>
        </div>

        <!-- Step 1 -->
        <div class="quiz-step" id="step-1">
        <p data-al="Hapi 1 / 7" data-en="Step 1 / 7" class="text-xs font-semibold uppercase tracking-[0.2em] text-[#2C1239]/60 mb-2">Hapi 1 / 7</p>
        <h4 data-al="Ku doni të shkoni?" data-en="Where would you like to go?" class="text-xl font-semibold text-slate-900 mb-1">Ku doni të shkoni?</h4>
        <p data-al="Zgjedhni destinacionin tuaj të preferuar." data-en="Choose your preferred destination." class="text-sm text-slate-500 mb-6">Zgjedhni destinacionin tuaj të preferuar.</p>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3" data-q="1">
            <button class="quiz-opt rounded-xl border border-slate-200 p-4 text-left hover:border-[#2C1239] hover:bg-[#2C1239]/5 transition" data-v="Greqi">🇬🇷 <span data-al="Greqi" data-en="Greece" class="block font-medium text-sm mt-1">Greqi</span><span data-al="Ishuj, diell, histori" data-en="Islands, sun, history" class="text-xs text-slate-500">Ishuj, diell, histori</span></button>
            <button class="quiz-opt rounded-xl border border-slate-200 p-4 text-left hover:border-[#2C1239] hover:bg-[#2C1239]/5 transition" data-v="Itali">🇮🇹 <span data-al="Itali" data-en="Italy" class="block font-medium text-sm mt-1">Itali</span><span data-al="Romë, Milano, Amalfi" data-en="Rome, Milan, Amalfi" class="text-xs text-slate-500">Romë, Milano, Amalfi</span></button>
            <button class="quiz-opt rounded-xl border border-slate-200 p-4 text-left hover:border-[#2C1239] hover:bg-[#2C1239]/5 transition" data-v="Spanjë">🇪🇸 <span data-al="Spanjë" data-en="Spain" class="block font-medium text-sm mt-1">Spanjë</span><span data-al="Barcelonë, Majorka" data-en="Barcelona, Mallorca" class="text-xs text-slate-500">Barcelonë, Majorka</span></button>
            <button class="quiz-opt rounded-xl border border-slate-200 p-4 text-left hover:border-[#2C1239] hover:bg-[#2C1239]/5 transition" data-v="Turqi">🇹🇷 <span data-al="Turqi" data-en="Turkey" class="block font-medium text-sm mt-1">Turqi</span><span data-al="Stamboll, Antalya" data-en="Istanbul, Antalya" class="text-xs text-slate-500">Stamboll, Antalya</span></button>
            <button class="quiz-opt rounded-xl border border-slate-200 p-4 text-left hover:border-[#2C1239] hover:bg-[#2C1239]/5 transition" data-v="Kroaci">🇭🇷 <span data-al="Kroaci" data-en="Croatia" class="block font-medium text-sm mt-1">Kroaci</span><span data-al="Dubrovnik, ishuj" data-en="Dubrovnik, islands" class="text-xs text-slate-500">Dubrovnik, ishuj</span></button>
            <button class="quiz-opt rounded-xl border border-slate-200 p-4 text-left hover:border-[#2C1239] hover:bg-[#2C1239]/5 transition" data-v="Surprizomëni">🎲 <span data-al="Më surprizo!" data-en="Surprise me!" class="block font-medium text-sm mt-1">Më surprizo!</span><span data-al="Zgjedhni ju për mua" data-en="You choose for me" class="text-xs text-slate-500">Zgjedhni ju për mua</span></button>
        </div>
        <div class="flex justify-end mt-6">
            <button data-al="Vazhdoni →" data-en="Continue →" class="quiz-next rounded-full bg-[#2C1239] text-white px-6 py-2.5 text-sm font-medium disabled:opacity-40 transition" data-next="2" disabled>Vazhdoni →</button>
        </div>
        </div>

        <!-- Step 2 -->
        <div class="quiz-step hidden" id="step-2">
        <p data-al="Hapi 2 / 7" data-en="Step 2 / 7" class="text-xs font-semibold uppercase tracking-[0.2em] text-[#2C1239]/60 mb-2">Hapi 2 / 7</p>
        <h4 data-al="Çfarë lloj udhëtimi doni?" data-en="What kind of trip do you want?" class="text-xl font-semibold text-slate-900 mb-1">Çfarë lloj udhëtimi doni?</h4>
        <p data-al="Zgjedhni stilin e udhëtimit tuaj." data-en="Choose your travel style." class="text-sm text-slate-500 mb-6">Zgjedhni stilin e udhëtimit tuaj.</p>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3" data-q="2">
            <button class="quiz-opt rounded-xl border border-slate-200 p-4 text-left hover:border-[#2C1239] hover:bg-[#2C1239]/5 transition" data-v="Plazh & relaksim">🏖️ <span data-al="Plazh & relaksim" data-en="Beach & relax" class="block font-medium text-sm mt-1">Plazh & relaksim</span><span data-al="Diell, det, qetësi" data-en="Sun, sea, do nothing" class="text-xs text-slate-500">Diell, det, qetësi</span></button>
            <button class="quiz-opt rounded-xl border border-slate-200 p-4 text-left hover:border-[#2C1239] hover:bg-[#2C1239]/5 transition" data-v="Qytet & kulturë">🏛️ <span data-al="Qytet & kulturë" data-en="City & culture" class="block font-medium text-sm mt-1">Qytet & kulturë</span><span data-al="Muze, ushqim, shëtitje" data-en="Museums, food, walks" class="text-xs text-slate-500">Muze, ushqim, shëtitje</span></button>
            <button class="quiz-opt rounded-xl border border-slate-200 p-4 text-left hover:border-[#2C1239] hover:bg-[#2C1239]/5 transition" data-v="Aventurë">🧗 <span data-al="Aventurë" data-en="Adventure" class="block font-medium text-sm mt-1">Aventurë</span><span data-al="Hiking, aktiv, eksplorim" data-en="Hiking, active, explore" class="text-xs text-slate-500">Hiking, aktiv, eksplorim</span></button>
            <button class="quiz-opt rounded-xl border border-slate-200 p-4 text-left hover:border-[#2C1239] hover:bg-[#2C1239]/5 transition" data-v="Romantik">💕 <span data-al="Romantik" data-en="Romantic" class="block font-medium text-sm mt-1">Romantik</span><span data-al="Çift, muaj mjalti" data-en="Couples, honeymoon" class="text-xs text-slate-500">Çift, muaj mjalti</span></button>
            <button class="quiz-opt rounded-xl border border-slate-200 p-4 text-left hover:border-[#2C1239] hover:bg-[#2C1239]/5 transition" data-v="Argëtim & jetë nate">🎉 <span data-al="Argëtim & jetë nate" data-en="Party & nightlife" class="block font-medium text-sm mt-1">Argëtim & jetë nate</span><span data-al="Ibiza, Mykonos" data-en="Ibiza, Mykonos vibes" class="text-xs text-slate-500">Ibiza, Mykonos</span></button>
            <button class="quiz-opt rounded-xl border border-slate-200 p-4 text-left hover:border-[#2C1239] hover:bg-[#2C1239]/5 transition" data-v="Të gjitha nga pak">✨ <span data-al="Të gjitha nga pak" data-en="Mix of everything" class="block font-medium text-sm mt-1">Të gjitha nga pak</span><span data-al="Të gjitha nga pak" data-en="A bit of everything" class="text-xs text-slate-500">Të gjitha nga pak</span></button>
        </div>
        <div class="flex justify-between mt-6">
            <button data-al="← Kthehu" data-en="← Back" class="quiz-back rounded-full border border-slate-200 text-slate-600 px-6 py-2.5 text-sm font-medium hover:bg-slate-50 transition" data-back="1">← Kthehu</button>
            <button data-al="Vazhdoni →" data-en="Continue →" class="quiz-next rounded-full bg-[#2C1239] text-white px-6 py-2.5 text-sm font-medium disabled:opacity-40 transition" data-next="3" disabled>Vazhdoni →</button>
        </div>
        </div>

        <!-- Step 3 -->
        <div class="quiz-step hidden" id="step-3">
        <p data-al="Hapi 3 / 7" data-en="Step 3 / 7" class="text-xs font-semibold uppercase tracking-[0.2em] text-[#2C1239]/60 mb-2">Hapi 3 / 7</p>
        <h4 data-al="Me kë do të udhëtoni?" data-en="Who are you travelling with?" class="text-xl font-semibold text-slate-900 mb-1">Me kë do të udhëtoni?</h4>
        <p data-al="Zgjedhni me kë udhëtoni." data-en="Choose who you're travelling with." class="text-sm text-slate-500 mb-6">Zgjedhni me kë udhëtoni.</p>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3" data-q="3">
            <button class="quiz-opt rounded-xl border border-slate-200 p-4 text-left hover:border-[#2C1239] hover:bg-[#2C1239]/5 transition" data-v="Vetëm">🧍 <span data-al="Vetëm" data-en="Solo" class="block font-medium text-sm mt-1">Vetëm</span><span data-al="Vetëm unë" data-en="Just me" class="text-xs text-slate-500">Vetëm unë</span></button>
            <button class="quiz-opt rounded-xl border border-slate-200 p-4 text-left hover:border-[#2C1239] hover:bg-[#2C1239]/5 transition" data-v="Çift">👫 <span data-al="Çift" data-en="Couple" class="block font-medium text-sm mt-1">Çift</span><span data-al="Unë & partneri" data-en="Me & my partner" class="text-xs text-slate-500">Unë & partneri</span></button>
            <button class="quiz-opt rounded-xl border border-slate-200 p-4 text-left hover:border-[#2C1239] hover:bg-[#2C1239]/5 transition" data-v="Miq">👯 <span data-al="Miq" data-en="Friends" class="block font-medium text-sm mt-1">Miq</span><span data-al="Me shokë e shoqe" data-en="Group of friends" class="text-xs text-slate-500">Me shokë e shoqe</span></button>
            <button class="quiz-opt rounded-xl border border-slate-200 p-4 text-left hover:border-[#2C1239] hover:bg-[#2C1239]/5 transition" data-v="Familje">👨‍👩‍👧 <span data-al="Familje" data-en="Family" class="block font-medium text-sm mt-1">Familje</span><span data-al="Me fëmijë" data-en="Kids included" class="text-xs text-slate-500">Me fëmijë</span></button>
        </div>
        <div class="flex justify-between mt-6">
            <button data-al="← Kthehu" data-en="← Back" class="quiz-back rounded-full border border-slate-200 text-slate-600 px-6 py-2.5 text-sm font-medium hover:bg-slate-50 transition" data-back="2">← Kthehu</button>
            <button data-al="Vazhdoni →" data-en="Continue →" class="quiz-next rounded-full bg-[#2C1239] text-white px-6 py-2.5 text-sm font-medium disabled:opacity-40 transition" data-next="4" disabled>Vazhdoni →</button>
        </div>
        </div>

        <!-- Step 4 -->
        <div class="quiz-step hidden" id="step-4">
        <p data-al="Hapi 4 / 7" data-en="Step 4 / 7" class="text-xs font-semibold uppercase tracking-[0.2em] text-[#2C1239]/60 mb-2">Hapi 4 / 7</p>
        <h4 data-al="Sa ditë keni në plan?" data-en="How many days are you planning?" class="text-xl font-semibold text-slate-900 mb-1">Sa ditë keni në plan?</h4>
        <p data-al="Sa kohë planifikoni të qëndroni?" data-en="How long are you planning to stay?" class="text-sm text-slate-500 mb-6">Sa kohë planifikoni të qëndroni?</p>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3" data-q="4">
            <button class="quiz-opt rounded-xl border border-slate-200 p-4 text-left hover:border-[#2C1239] hover:bg-[#2C1239]/5 transition" data-v="3-4 ditë">⚡ <span data-al="3–4 ditë" data-en="3–4 days" class="block font-medium text-sm mt-1">3–4 ditë</span><span data-al="Ikje e shpejtë" data-en="Quick getaway" class="text-xs text-slate-500">Ikje e shpejtë</span></button>
            <button class="quiz-opt rounded-xl border border-slate-200 p-4 text-left hover:border-[#2C1239] hover:bg-[#2C1239]/5 transition" data-v="5-7 ditë">🗓️ <span data-al="5–7 ditë" data-en="5–7 days" class="block font-medium text-sm mt-1">5–7 ditë</span><span data-al="Javë klasike" data-en="Classic week" class="text-xs text-slate-500">Javë klasike</span></button>
            <button class="quiz-opt rounded-xl border border-slate-200 p-4 text-left hover:border-[#2C1239] hover:bg-[#2C1239]/5 transition" data-v="8-14 ditë">🌍 <span data-al="8–14 ditë" data-en="8–14 days" class="block font-medium text-sm mt-1">8–14 ditë</span><span data-al="Pushime të gjata" data-en="Long holiday" class="text-xs text-slate-500">Pushime të gjata</span></button>
            <button class="quiz-opt rounded-xl border border-slate-200 p-4 text-left hover:border-[#2C1239] hover:bg-[#2C1239]/5 transition" data-v="Nuk jam e sigurt">🤷 <span data-al="Nuk jam e sigurt" data-en="Not sure yet" class="block font-medium text-sm mt-1">Nuk jam e sigurt</span><span data-al="Fleksibël" data-en="Flexible" class="text-xs text-slate-500">Fleksibël</span></button>
        </div>
        <div class="flex justify-between mt-6">
            <button data-al="← Kthehu" data-en="← Back" class="quiz-back rounded-full border border-slate-200 text-slate-600 px-6 py-2.5 text-sm font-medium hover:bg-slate-50 transition" data-back="3">← Kthehu</button>
            <button data-al="Vazhdoni →" data-en="Continue →" class="quiz-next rounded-full bg-[#2C1239] text-white px-6 py-2.5 text-sm font-medium disabled:opacity-40 transition" data-next="5" disabled>Vazhdoni →</button>
        </div>
        </div>

        <!-- Step 5 - Budget slider -->
        <div class="quiz-step hidden" id="step-5">
        <p data-al="Hapi 5 / 7" data-en="Step 5 / 7" class="text-xs font-semibold uppercase tracking-[0.2em] text-[#2C1239]/60 mb-2">Hapi 5 / 7</p>
        <h4 data-al="Çfarë buxheti keni për person?" data-en="What's your budget per person?" class="text-xl font-semibold text-slate-900 mb-1">Çfarë buxheti keni për person?</h4>
        <p data-al="Buxheti për person — fluturime + hotel të përfshira" data-en="Budget per person — flights + hotel included" class="text-sm text-slate-500 mb-6">Buxheti për person — fluturime + hotel të përfshira</p>
        <div class="text-3xl font-semibold text-[#2C1239] mb-4" id="budget-val">€300</div>
        <input type="range" min="100" max="2000" step="50" value="300" id="budget-slider"
            class="w-full accent-[#2C1239] mb-2" />
        <div class="flex justify-between text-xs text-slate-400">
