        <script is:inline>
(function() {
  const answers = { budget: '€300' };

  document.querySelectorAll('.quiz-opt').forEach(btn => {
    btn.addEventListener('click', function() {
      const grid = this.closest('[data-q]');
      const q = grid.dataset.q;
      grid.querySelectorAll('.quiz-opt').forEach(b => {
        b.classList.remove('border-[#2C1239]', 'bg-[#2C1239]/5');
        b.classList.add('border-slate-200');
      });
      this.classList.add('border-[#2C1239]', 'bg-[#2C1239]/5');
      this.classList.remove('border-slate-200');
      answers['q' + q] = this.dataset.v;
      const step = this.closest('.quiz-step');
      const nextBtn = step.querySelector('.quiz-next');
      if (nextBtn) nextBtn.disabled = false;
      updateProgress();
    });
  });

  document.getElementById('budget-slider').addEventListener('input', function() {
    const v = parseInt(this.value);
    const display = v >= 2000 ? '€2000+' : '€' + v;
    document.getElementById('budget-val').textContent = display;
    answers.budget = display;
  });

  function updateProgress() {
    const filled = Object.keys(answers).length;
    const pct = Math.min(Math.round((filled / 7) * 100), 100);
    document.getElementById('quiz-progress').style.width = pct + '%';
  }

  document.querySelectorAll('.quiz-next').forEach(btn => {
    btn.addEventListener('click', function() {
      if (this.disabled) return;
      const next = this.dataset.next;
      document.querySelectorAll('.quiz-step').forEach(s => s.classList.add('hidden'));
      document.getElementById('step-' + next).classList.remove('hidden');
      updateProgress();
    });
  });

  document.querySelectorAll('.quiz-back').forEach(btn => {
    btn.addEventListener('click', function() {
      const back = this.dataset.back;
      document.querySelectorAll('.quiz-step').forEach(s => s.classList.add('hidden'));
      document.getElementById('step-' + back).classList.remove('hidden');
    });
  });

  const nameEl = document.getElementById('q-name');
  const phoneEl = document.getElementById('q-phone');
  const submitBtn = document.getElementById('quiz-submit');

  [nameEl, phoneEl].forEach(el => {
    el.addEventListener('input', function() {
      submitBtn.disabled = !(nameEl.value.trim() && phoneEl.value.trim());
    });
  });

  const summaryLabels = {
    al: { dest: 'Destinacioni', type: 'Lloji', with: 'Me kë', days: 'Ditët', budget: 'Buxheti', period: 'Periudha', name: 'Emri', phone: 'Telefoni' },
    en: { dest: 'Destination', type: 'Trip type', with: 'Travelling with', days: 'Days', budget: 'Budget', period: 'Period', name: 'Name', phone: 'Phone' },
  };

  submitBtn.addEventListener('click', function() {
    const name = nameEl.value.trim();
    const phone = phoneEl.value.trim();
    if (!name || !phone) return;
    answers.name = name;
    answers.phone = phone;

    const lang = localStorage.getItem('lang') || 'al';
    const L = summaryLabels[lang];
    const rows = [
      [L.dest, answers.q1 || '-'],
      [L.type, answers.q2 || '-'],
      [L.with, answers.q3 || '-'],
      [L.days, answers.q4 || '-'],
      [L.budget, answers.budget],
      [L.period, answers.q6 || '-'],
      [L.name, name],
      [L.phone, phone],
    ];

    document.getElementById('quiz-summary').innerHTML = rows
      .map(r => `<div class="flex justify-between border-b border-slate-100 pb-1"><span class="text-slate-500">${r[0]}</span><span class="font-medium">${r[1]}</span></div>`)
      .join('');

    const msg = `Pershendetje Truvia Travel! 👋\n\nEmri: ${name}\nTelefoni: ${phone}\nDestinacioni: ${answers.q1||'-'}\nLloji: ${answers.q2||'-'}\nMe kë: ${answers.q3||'-'}\nDitët: ${answers.q4||'-'}\nBuxheti: ${answers.budget}\nPeriudha: ${answers.q6||'-'}\n\nJu lutem me kontaktoni me ofertat me te mira! 🙏`;
    document.getElementById('quiz-wa').href = 'https://wa.me/38344238343?text=' + encodeURIComponent(msg);

    document.querySelectorAll('.quiz-step').forEach(s => s.classList.add('hidden'));
    document.getElementById('step-result').classList.remove('hidden');
    document.getElementById('quiz-progress').style.width = '100%';
  });

  document.getElementById('quiz-restart').addEventListener('click', function() {
    Object.keys(answers).forEach(k => { if (k !== 'budget') delete answers[k]; });
    answers.budget = '€300';
    document.getElementById('budget-slider').value = 300;
    document.getElementById('budget-val').textContent = '€300';
    document.querySelectorAll('.quiz-opt').forEach(b => {
      b.classList.remove('border-[#2C1239]', 'bg-[#2C1239]/5');
      b.classList.add('border-slate-200');
    });
    document.querySelectorAll('.quiz-next').forEach(b => { if (b.dataset.next !== '6') b.disabled = true; });
    document.getElementById('q-name').value = '';
    document.getElementById('q-phone').value = '';
    document.querySelectorAll('.quiz-step').forEach(s => s.classList.add('hidden'));
    document.getElementById('step-1').classList.remove('hidden');
    document.getElementById('quiz-progress').style.width = '14%';
  });
})();
</script>


