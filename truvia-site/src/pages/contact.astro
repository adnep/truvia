---
const title = "Kontaktoni Truvia Travel";
const desc = "Na kontaktoni - udhëtime të planifikuara me kujdes, pushime të bukura, dhe këshilla për aventurën tuaj ideale.";
const pathname = Astro.url.pathname;

const links = [
  { href: "/", label: "Home" },
];

const isActive = (href: string) => {
  if (href === "/") return pathname === "/";
  return pathname.startsWith(href);
};

import "../styles/global.css";
import { Image } from "astro:assets";
import b from "../assets/b.jpg";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width,initial-scale=1" />
        <title>{title}</title>
        <meta name="description" content={desc} />
    </head>

    <body class="min-h-screen bg-gradient-to-b from-white font-pristine to-gray-100 text-gray-800">
        <!-- NAVBAR -->
        <header class="sticky top-0 z-50 border-b border-black/20 bg-[#2C1239]">
        <div class="flex items-center justify-between px-4 sm:px-6 py-0">
            <!-- Logo -->
            <a href="/" class="flex items-center py-0 my-0 leading-none">
			<img
				src="/logo_truvia.jpg"
				alt="Truvia Travel logo"
				class="block h-14 w-auto object-contain"
			/>
			</a>

            <!-- Desktop Nav -->
            <nav class="hidden items-center gap-3 text-sm font-medium sm:flex">
            {links.map((l) => (
                <a
                href={l.href}
                class:list={[
                    "rounded-full px-3 py-2 transition",
                    "text-white/80 hover:text-white hover:bg-white/10",
                    "focus:outline-none focus-visible:ring-2 focus-visible:ring-white/40",
                    isActive(l.href) ? "bg-white/15 text-white" : "",
                ]}
                aria-current={isActive(l.href) ? "page" : undefined}
                >
                {l.label}
                </a>
            ))}

            <!-- Language toggle -->
            <button
                id="lang-toggle"
                type="button"
                aria-label="Switch language"
                class="inline-flex items-center gap-1 rounded-full border border-white/30 px-3 py-1.5 text-xs font-semibold hover:bg-white/10 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-white/40"
            >
                <span id="lang-label-sq" class="text-white transition">AL</span>
                <span class="text-white/30">|</span>
                <span id="lang-label-en" class="text-white/40 transition">EN</span>
            </button>

            <!-- CTA -->
            <a
                href="/contact"
                data-al="Na kontaktoni"
                data-en="Contact us"
                class="inline-flex items-center rounded-full bg-white px-4 py-2 text-sm font-semibold text-[#0B3D2E] shadow-sm transition hover:bg-white/90 focus:outline-none focus-visible:ring-2 focus-visible:ring-white/40"
            >
                Na kontaktoni
            </a>
            </nav>

            <!-- Mobile right side -->
            <div class="flex items-center gap-2 sm:hidden">
            <button
                id="lang-toggle-mobile"
                type="button"
                aria-label="Switch language"
                class="inline-flex items-center gap-1 rounded-full border border-white/30 px-2.5 py-1 text-xs font-semibold hover:bg-white/10 transition"
            >
                <span id="lang-label-sq-mob" class="text-white transition">SQ</span>
                <span class="text-white/30">|</span>
                <span id="lang-label-en-mob" class="text-white/40 transition">EN</span>
            </button>
            <button
                id="nav-toggle"
                type="button"
                class="inline-flex items-center justify-center rounded-xl p-2 text-white/90 transition hover:bg-white/10 focus:outline-none focus-visible:ring-2 focus-visible:ring-white/40"
                aria-label="Open menu"
                aria-expanded="false"
                aria-controls="mobile-nav"
            >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            </button>
            </div>
        </div>

        <!-- Mobile Nav -->
        <div id="mobile-nav" class="hidden border-t border-white/10 bg-[#0B3D2E] sm:hidden">
            <nav class="flex flex-col gap-1 px-4 sm:px-6 py-3 text-sm font-medium">
            {links.map((l) => (
                <a
                href={l.href}
                class:list={[
                    "rounded-xl px-3 py-2 transition",
                    "text-white/85 hover:bg-white/10 hover:text-white",
                    isActive(l.href) ? "bg-white/15 text-white" : "",
                ]}
                aria-current={isActive(l.href) ? "page" : undefined}
                >
                {l.label}
                </a>
            ))}
            <a
                href="/contact"
                data-al="Na kontaktoni"
                data-en="Contact us"
                class="mt-2 inline-flex items-center justify-center rounded-xl bg-white px-4 py-2 font-semibold text-[#0B3D2E] hover:bg-white/90"
            >
                Na kontaktoni
            </a>
            </nav>
        </div>

        <script is:inline>
            const btn = document.getElementById("nav-toggle");
            const menu = document.getElementById("mobile-nav");
            if (btn && menu) {
                btn.addEventListener("click", () => {
                    const expanded = btn.getAttribute("aria-expanded") === "true";
                    btn.setAttribute("aria-expanded", String(!expanded));
                    menu.classList.toggle("hidden");
                });
            }
        </script>
        </header>

        <div aria-hidden="true" class="fixed inset-0 -z-10">
            <Image
                src={b}
                alt="bg"
                class="absolute inset-0 h-full w-full object-cover"
                loading="eager"
                decoding="async"
                fetchpriority="high"
            />
            <div class="absolute inset-0 bg-black/15"></div>
        </div>

        <main class="grid place-items-center min-h-screen px-6">
            <section class="w-full max-w-3xl text-center">
                <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight leading-tight text-white drop-shadow pt-6">
                    <span data-al="Na kontaktoni te" data-en="Contact">Na kontaktoni te</span>
                    <span> <span class="underline decoration-white/30">Truvia Travel</span></span>
                </h1>
                <p
                    data-al="Na trego për udhëtimin tënd të ëndrrave — ne do ta bëjmë realitet!"
                    data-en="Tell us about your dream trip — we'll make it happen!"
                    class="mt-3 text-lg text-white/85">
                Na trego për udhëtimin tënd të ëndrrave — ne do ta bëjmë realitet!
                </p>

                <form
                id="contact"
                action="https://formspree.io/f/xeordlzr"
                method="POST"
                onsubmit="return handleContactSubmit(event)"
                class="mx-auto mt-8 text-left rounded-2xl bg-white/10 backdrop-blur-md border border-white/20 shadow-lg p-6 sm:p-8 max-w-xl"
                >
                <div class="grid gap-5">
                    <div>
                    <label for="name" data-al="Emri" data-en="Name" class="block text-sm font-medium text-white/90">Emri</label>
                    <input id="name" name="name" required
                            data-al-placeholder="Emri yt"
                            data-en-placeholder="Your name"
                            class="mt-2 w-full rounded-md bg-white/10 text-white placeholder-white/60
                                    border border-white/25 focus:outline-none focus:ring-2 focus:ring-white/50 px-3 py-2"
                            placeholder="Emri yt" />
                    </div>

                    <div>
                    <label for="email" class="block text-sm font-medium text-white/90">Email</label>
                    <input id="email" type="email" name="email" required
                            data-al-placeholder="ti@shembull.com"
                            data-en-placeholder="you@example.com"
                            class="mt-2 w-full rounded-md bg-white/10 text-white placeholder-white/60
                                    border border-white/25 focus:outline-none focus:ring-2 focus:ring-white/50 px-3 py-2"
                            placeholder="ti@shembull.com" />
                    </div>

                    <div class="grid sm:grid-cols-2 gap-5">
                    <div>
                        <label for="dates" data-al="Datat (opsionale)" data-en="Dates (optional)" class="block text-sm font-medium text-white/90">Datat (opsionale)</label>
                        <input id="dates" name="dates"
                            data-al-placeholder="p.sh., 12–20 Maj"
                            data-en-placeholder="e.g., May 12–20"
                            class="mt-2 w-full rounded-md bg-white/10 text-white placeholder-white/60
                                    border border-white/25 focus:outline-none focus:ring-2 focus:ring-white/50 px-3 py-2"
                            placeholder="p.sh., 12–20 Maj" />
                    </div>
                    <div>
                        <label for="destination" data-al="Destinacioni (opsional)" data-en="Destination (optional)" class="block text-sm font-medium text-white/90">Destinacioni (opsional)</label>
                        <input id="destination" name="destination"
                            data-al-placeholder="p.sh., Bali, Paris"
                            data-en-placeholder="e.g., Bali, Paris"
                            class="mt-2 w-full rounded-md bg-white/10 text-white placeholder-white/60
                                    border border-white/25 focus:outline-none focus:ring-2 focus:ring-white/50 px-3 py-2"
                            placeholder="p.sh., Bali, Paris" />
                    </div>
                    </div>

                    <div>
                    <label for="message" data-al="Mesazhi" data-en="Message" class="block text-sm font-medium text-white/90">Mesazhi</label>
                    <textarea id="message" name="message" rows="6" required
                                data-al-placeholder="Si mund t'ju ndihmojmë?"
                                data-en-placeholder="How can we help you?"
                                class="mt-2 w-full rounded-md bg-white/10 text-white placeholder-white/60
                                    border border-white/25 focus:outline-none focus:ring-2 focus:ring-white/50 px-3 py-2"
                                placeholder="Si mund t'ju ndihmojmë?"></textarea>
                    </div>

                    <input type="text" name="_perspemera" tabindex="-1" autocomplete="off" class="hidden" />

                    <p id="status" class="text-sm text-white/85" aria-live="polite"></p>

                    <button
                    id="submitBtn"
                    type="submit"
                    data-al="Dërgo mesazhin"
                    data-en="Send message"
                    class="mt-2 rounded-full bg-white text-slate-900 px-6 py-3 text-sm font-medium
                            hover:bg-white/90 shadow-sm ring-1 ring-white/20"
                    >
                    Dërgo mesazhin
                    </button>
                </div>
                </form>

                <script is:inline>
                const contactMessages = {
                  al: {
                    sending: 'Duke dërguar…',
                    success: 'Mesazhi u dërgua me sukses. Ne do të kthehemi tek ju së shpejti.',
                    error: 'Diçka shkoi keq. Ju lutemi provoni përsëri.',
                    network: 'Gabim rrjeti. Ju lutem provoni përsëri.',
                  },
                  en: {
                    sending: 'Sending…',
                    success: 'Message sent successfully. We\'ll get back to you soon.',
                    error: 'Something went wrong. Please try again.',
                    network: 'Network error. Please try again.',
                  },
                };

                async function handleContactSubmit(event) {
                    event.preventDefault();
                    const form = event.target;
                    const statusEl = document.getElementById('status');
                    const submitBtn = document.getElementById('submitBtn');

                    if (!form || !statusEl || !submitBtn) return false;
                    if (!form.checkValidity()) { form.reportValidity(); return false; }

                    const lang = localStorage.getItem('lang') || 'al';
                    const m = contactMessages[lang];

                    statusEl.textContent = m.sending;
                    submitBtn.disabled = true;

                    try {
                        const res = await fetch(form.action, {
                            method: 'POST',
                            body: new FormData(form),
                            headers: { Accept: 'application/json' }
                        });
                        if (res.ok) {
                            form.reset();
                            statusEl.textContent = m.success;
                        } else {
                            statusEl.textContent = m.error;
                        }
                    } catch (err) {
                        statusEl.textContent = m.network;
                        console.error(err);
                    } finally {
                        submitBtn.disabled = false;
                    }
                    return false;
                }
                </script>

                <p class="mt-8 text-sm text-white/100">
                    <span data-al="Preferoni email?" data-en="Prefer email?">Preferoni email?</span>
                    <a href="mailto:info@truviatravel.com" class="underline decoration-white/40 hover:decoration-white">
                        info@truviatravel.com
                    </a>
                <br /><br />
                </p>
            </section>
        </main>

        <!-- Language switcher script -->
        <script is:inline>
        (function() {
          function applyLang(lang) {
            document.querySelectorAll('[data-al][data-en]').forEach(el => {
              el.textContent = lang === 'al' ? el.dataset.al : el.dataset.en;
            });
            document.querySelectorAll('[data-al-placeholder][data-en-placeholder]').forEach(el => {
              el.placeholder = lang === 'al' ? el.dataset.alPlaceholder : el.dataset.enPlaceholder;
            });
            const active = 'text-white transition';
            const inactive = 'text-white/40 transition';
            [['lang-label-sq', 'lang-label-en'], ['lang-label-sq-mob', 'lang-label-en-mob']].forEach(([sq, en]) => {
              const sqEl = document.getElementById(sq);
              const enEl = document.getElementById(en);
              if (!sqEl || !enEl) return;
              sqEl.className = lang === 'al' ? active : inactive;
              enEl.className = lang === 'al' ? inactive : active;
            });
            localStorage.setItem('lang', lang);
          }

          function toggleLang() {
            const current = localStorage.getItem('lang') || 'al';
            applyLang(current === 'al' ? 'en' : 'al');
          }

          applyLang(localStorage.getItem('lang') || 'al');

          document.getElementById('lang-toggle').addEventListener('click', toggleLang);
          const mob = document.getElementById('lang-toggle-mobile');
          if (mob) mob.addEventListener('click', toggleLang);
        })();
        </script>
    </body>
</html>
